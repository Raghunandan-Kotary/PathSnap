# Logs
*.log
api/logs/*.log

# Large Datasets and Archives
# Raw data archives should remain local
*.zip
*.tar.gz
*.rar
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Saved model binary weights (keep .gitkeep, push final small model if within GitHub limits)
models/saved/*.joblib
models/saved/*.pt
models/saved/*.pkl
!models/saved/.gitkeep
!models/saved/best_model.joblib
!models/final/model.joblib

# Map HTML exports (generated dynamically)
maps/html/*.html
!maps/html/.gitkeep
